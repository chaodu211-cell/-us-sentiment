#!/bin/bash
# 双击我：强制重下十年历史 → 重算温度 → 打开网页
#
# 日常不需要用这个，用「更新并打开.command」就行——增量模式自己会处理拆股/分红
# 导致的复权重算，距上次全量超过 30 天也会自动整体全量一次。
#
# 什么时候才用它：怀疑本地数据有问题（读数明显不合理、某些票缺了一大段），
# 或者手工删过 raw/ 里的文件。代价是要重下约 40MB，慢得多。

cd "$(dirname "$0")" || { echo "无法进入脚本所在目录"; exit 1; }

# 逻辑跟增量那个完全一样，只是把模式切成全量，避免两份脚本各改各的走样。
SENTIMENT_FULL=1 exec "./更新并打开.command"
